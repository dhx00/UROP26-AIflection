# Copy to .env locally. On Render/Railway, set these in the dashboard (Environment).

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions

ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional comma-separated fallbacks if the primary model 404s:
# ANTHROPIC_MODEL_FALLBACKS=claude-haiku-4-5-20251001
ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages
ANTHROPIC_VERSION=2023-06-01

DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions

# Volcengine Ark (OpenAI-compatible). Names stay DOUBAO_* for compatibility.
DOUBAO_API_KEY=REPLACE_WITH_ARK_API_KEY
DOUBAO_MODEL=REPLACE_WITH_ENDPOINT_OR_MODEL_ID
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
